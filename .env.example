# gotit-ai local / self-host config
# cp .env.example .env

# API
GOTIT_HOST=127.0.0.1
GOTIT_PORT=8787
GOTIT_API_KEY=dev-change-me
GOTIT_USER_ID=local
# Auto-create tables on startup (dev). Prefer `alembic upgrade head` in prod.
GOTIT_DB_CREATE_ALL=true

# Postgres (Docker Compose)
DATABASE_URL=postgresql+asyncpg://gotit:gotit@127.0.0.1:5432/gotit
# Without Docker, use SQLite instead:
# DATABASE_URL=sqlite+aiosqlite:///./gotit.db

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# LLM (OpenAI-compatible)
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini
# 智谱免费档:
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# Optional Critic (凯伦) independent model — lowers same-model self-preference vs Axiom.
# Precedence: agent_identities.llm_config → these CRITIC_* → LLM_* above.
# Identity llm_config keys: model|model_name, base_url, api_key|api_key_env
# CRITIC_MODEL=
# CRITIC_BASE_URL=
# CRITIC_API_KEY=

# Optional STT for in-app voice teach-back (OpenAI-compatible transcriptions).
# Empty STT_* falls back to LLM_*; no key → UI keeps text-only teach path.
# STT_API_KEY=
# STT_BASE_URL=
# STT_MODEL=whisper-1
# STT_STUB=false

# Web
VITE_API_BASE_URL=http://127.0.0.1:8787
VITE_GOTIT_API_KEY=dev-change-me
