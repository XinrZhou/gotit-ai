#!/usr/bin/osascript -l JavaScript
/**
 * Create/update reminders in a named list (create list if missing).
 * Each item: {title, due:"YYYY-MM-DD", time?:"HH:MM"}
 * Sets dueDate only — no remindMeDate / alerts.
 * Optional argv[2]: {reconcile:true, due:"YYYY-MM-DD", keep:["title",...]}
 *   → delete incomplete reminders on that due day whose titles are not in keep.
 */
function run(argv) {
  var listName = (argv && argv[0]) ? String(argv[0]) : "学习计划";
  var raw = (argv && argv[1]) ? String(argv[1]) : "[]";
  var optRaw = (argv && argv[2]) ? String(argv[2]) : "";
  var items;
  var opts = {};
  try {
    items = JSON.parse(raw);
  } catch (e) {
    return JSON.stringify({ ok: false, error: "items JSON 无效: " + String(e) });
  }
  if (optRaw) {
    try {
      opts = JSON.parse(optRaw) || {};
    } catch (e2) {
      return JSON.stringify({ ok: false, error: "opts JSON 无效: " + String(e2) });
    }
  }
  if (!items) items = [];

  function sameDay(d, ymd) {
    if (!d || !ymd) return false;
    try {
      var y = d.getFullYear();
      var m = d.getMonth() + 1;
      var day = d.getDate();
      var mm = (m < 10 ? "0" : "") + m;
      var dd = (day < 10 ? "0" : "") + day;
      return y + "-" + mm + "-" + dd === ymd;
    } catch (e) {
      return false;
    }
  }

  try {
    var app = Application("Reminders");
    app.includeStandardAdditions = true;

    var lists = app.lists.whose({ name: listName })();
    var list;
    if (!lists || lists.length === 0) {
      list = app.List({ name: listName });
      app.lists.push(list);
      lists = app.lists.whose({ name: listName })();
      list = lists[0];
    } else {
      list = lists[0];
    }

    var byTitle = {};
    var reminders = list.reminders();
    for (var i = 0; i < reminders.length; i++) {
      var r = reminders[i];
      try {
        if (r.completed()) continue;
      } catch (e0) {}
      var t = "";
      try {
        t = String(r.name() || "").trim().toLowerCase();
      } catch (e1) {}
      if (t) byTitle[t] = r;
    }

    var created = 0;
    var updated = 0;
    var skipped = 0;
    var deleted = 0;
    var errors = [];

    for (var j = 0; j < items.length; j++) {
      var it = items[j] || {};
      var title = String(it.title || "").trim();
      var due = String(it.due || "").trim();
      var time = String(it.time || "09:00").trim();
      if (!title) {
        skipped++;
        continue;
      }
      if (!due || !/^\d{4}-\d{2}-\d{2}$/.test(due)) {
        errors.push(title + ": 缺少到期日");
        continue;
      }
      if (!/^\d{2}:\d{2}$/.test(time)) {
        time = "09:00";
      }

      var when = new Date(due + "T" + time + ":00");
      var key = title.toLowerCase();
      try {
        if (byTitle[key]) {
          var existing = byTitle[key];
          existing.dueDate = when;
          try {
            existing.remindMeDate = null;
          } catch (eClear) {}
          updated++;
        } else {
          var rem = app.Reminder({ name: title, dueDate: when });
          list.reminders.push(rem);
          byTitle[key] = rem;
          created++;
        }
      } catch (err) {
        errors.push(title + ": " + String(err));
      }
    }

    if (opts.reconcile && opts.due) {
      var keep = {};
      var keepList = opts.keep || [];
      for (var k = 0; k < keepList.length; k++) {
        var kt = String(keepList[k] || "").trim().toLowerCase();
        if (kt) keep[kt] = true;
      }
      var dueFilter = String(opts.due).trim();
      reminders = list.reminders();
      for (var di = reminders.length - 1; di >= 0; di--) {
        var dr = reminders[di];
        try {
          if (dr.completed()) continue;
        } catch (e3) {}
        var dname = "";
        try {
          dname = String(dr.name() || "").trim().toLowerCase();
        } catch (e4) {
          continue;
        }
        if (keep[dname]) continue;
        var dd = null;
        try {
          dd = dr.dueDate();
        } catch (e5) {}
        if (!sameDay(dd, dueFilter)) continue;
        try {
          app.delete(dr);
          deleted++;
        } catch (e6) {
          errors.push(dname + ": " + String(e6));
        }
      }
    }

    return JSON.stringify({
      ok: errors.length === 0,
      created: created,
      updated: updated,
      skipped: skipped,
      deleted: deleted,
      list: listName,
      errors: errors,
      error: errors.length ? errors.join("; ") : undefined,
    });
  } catch (err) {
    return JSON.stringify({
      ok: false,
      error:
        "无法写入提醒事项：" +
        String(err) +
        "。请在 系统设置 → 隐私与安全性 → 提醒事项 中允许终端/OpenClaw。",
    });
  }
}
